MARIADB_HOST=localhost
MARIADB_PORT=3307
MARIADB_USER=root
MARIADB_PASSWORD=replace-with-your-local-password
MARIADB_DATABASE=licoreriadatabase
# Para una base remota, ruta al certificado CA confiable del proveedor.
# MARIADB_SSL_CA=/etc/secrets/mariadb-ca.pem
# MARIADB_CONNECTION_TIMEOUT=30
# PostgreSQL está en migración: inicio de sesión y algunos listados disponibles.
# No desplegar la API hasta completar y verificar la migración y los permisos.
# DATABASE_BACKEND=postgresql
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/postgres
# POSTGRES_SSL_ROOT_CERT=/etc/secrets/supabase-ca.crt
# El rol se valida por conexión: sin privilegios administrativos, BYPASSRLS,
# CREATE en public ni propiedad/membresía sobre objetos de ese esquema.
MARIADB_USER_ID=replace-with-an-existing-id_Usuario
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
